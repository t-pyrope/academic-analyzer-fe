{
  "schema_version": "1.0",
  "profile_id": "czu.ftz.bachelor_thesis",
  "institution": {
    "university": "Česká zemědělská univerzita v Praze",
    "faculty": "Fakulta tropického zemědělství",
    "faculty_code": "FTZ"
  },
  "year": 2018,
  "source_document": {
    "filename": "czu-ftz-bp-2018.pdf",
    "last_updated": "2018-02-15"
  },
  "notes": [
    "This manual states that it was prepared in accordance with Rector's Directive No. 8/2011.",
    "For bachelor theses containing own research, the manual directs students to adapt the content according to the FTZ master's-thesis manual."
  ],
  "rules": [
    {
      "rule_id": "frontmatter.title_page",
      "definition": "structure.required_content",
      "severity": "error",
      "parameters": {
        "requires": [
          "student_name",
          "supervisor_name",
          "optional_consultant",
          "thesis_title",
          "submission_year",
          "university",
          "faculty"
        ]
      }
    },
    {
      "rule_id": "frontmatter.assignment",
      "definition": "assignment.approval",
      "severity": "error",
      "parameters": {
        "source": "UIS",
        "printed_for": "paper_version",
        "electronic_approval": [
          "head_of_department",
          "dean_of_FTZ"
        ],
        "advisor_signature_not_required": true,
        "immutable_after_approval": true
      }
    },
    {
      "rule_id": "frontmatter.declaration",
      "definition": "authorship.declaration",
      "severity": "error",
      "parameters": {
        "requires": [
          "independent_work",
          "original_text",
          "all_used_sources_cited",
          "date",
          "student_signature"
        ]
      }
    },
    {
      "rule_id": "frontmatter.acknowledgements",
      "definition": "structure.optional_section",
      "severity": "recommendation",
      "parameters": {
        "optional": true,
        "mention_funding_if_applicable": true,
        "recommended_max_lines": 10
      }
    },
    {
      "rule_id": "abstract.languages",
      "definition": "abstract.languages",
      "severity": "error",
      "parameters": {
        "languages": [
          "cs",
          "en"
        ],
        "content_identical": true
      }
    },
    {
      "rule_id": "abstract.content",
      "definition": "abstract.content",
      "severity": "error",
      "parameters": {
        "requires": [
          "goals",
          "methodology",
          "key_results",
          "conclusions",
          "scientific_contribution"
        ]
      }
    },
    {
      "rule_id": "abstract.length",
      "definition": "abstract.length",
      "severity": "recommendation",
      "parameters": {
        "min_words": 200,
        "max_words": 350,
        "max_pages": 1
      }
    },
    {
      "rule_id": "abstract.style",
      "definition": "abstract.tense",
      "severity": "recommendation",
      "parameters": {
        "tense": "past"
      }
    },
    {
      "rule_id": "keywords.count",
      "definition": "keywords.count",
      "severity": "recommendation",
      "parameters": {
        "target": 5,
        "range": [
          5,
          6
        ]
      }
    },
    {
      "rule_id": "keywords.title_overlap",
      "definition": "keywords.title_overlap",
      "severity": "recommendation",
      "parameters": {
        "avoid_terms_in_title": true
      }
    },
    {
      "rule_id": "format.font",
      "definition": "format.font",
      "severity": "recommendation",
      "parameters": {
        "preferred": [
          "Times New Roman",
          "Calibri"
        ],
        "size_pt": 12
      }
    },
    {
      "rule_id": "format.line_spacing",
      "definition": "format.line_spacing",
      "severity": "recommendation",
      "parameters": {
        "value": 1.5
      }
    },
    {
      "rule_id": "format.margins",
      "definition": "format.margins",
      "severity": "recommendation",
      "parameters": {
        "top_cm": 3.0,
        "bottom_cm": 2.5,
        "left_cm": 3.0,
        "right_cm": 3.0
      }
    },
    {
      "rule_id": "format.page_numbering",
      "definition": "format.page_numbering",
      "severity": "recommendation",
      "parameters": {
        "starts_with_section": "Úvod",
        "first_displayed_number": 1
      }
    },
    {
      "rule_id": "format.printing",
      "definition": "format.printing",
      "severity": "recommendation",
      "parameters": {
        "double_sided": true
      }
    },
    {
      "rule_id": "length.bachelor",
      "definition": "length.main_text",
      "severity": "recommendation",
      "parameters": {
        "min_pages": 30,
        "max_pages": 50
      }
    },
    {
      "rule_id": "structure.literature_review",
      "definition": "structure.thesis_type",
      "severity": "error",
      "parameters": {
        "type": "literature_review",
        "sections": [
          "Úvod",
          "Cíle práce",
          "Metodika",
          "Literární rešerše",
          "Závěry",
          "Reference"
        ]
      }
    },
    {
      "rule_id": "structure.research",
      "definition": "structure.thesis_type",
      "severity": "recommendation",
      "parameters": {
        "type": "own_research",
        "sections": [
          "Úvod a literární rešerše",
          "Cíle práce",
          "Metodika",
          "Výsledky",
          "Diskuze",
          "Závěry",
          "Reference"
        ]
      }
    },
    {
      "rule_id": "structure.preliminaries",
      "definition": "structure.order",
      "severity": "error",
      "parameters": {
        "order": [
          "Titulní strana",
          "Zadání",
          "Prohlášení",
          "Poděkování",
          "Abstrakty CS/EN",
          "Obsah",
          "Seznam tabulek",
          "Seznam obrázků/grafů",
          "Seznam zkratek",
          "Textová část",
          "Přílohy"
        ]
      }
    },
    {
      "rule_id": "content.introduction",
      "definition": "section.introduction",
      "severity": "warning",
      "parameters": {
        "purpose": "introduce_problem_and_why_it_is_important",
        "uses_citations": true,
        "typical_length_pages": 1
      }
    },
    {
      "rule_id": "content.goals",
      "definition": "section.goals",
      "severity": "error",
      "parameters": {
        "ordered_from_general_to_specific": true,
        "must_be_realistic": true,
        "must_state_new_contribution": true
      }
    },
    {
      "rule_id": "methodology.literature_review",
      "definition": "methodology.research",
      "severity": "warning",
      "parameters": {
        "requires": [
          "how_information_was_obtained",
          "selection_criteria",
          "keyword_combinations",
          "number_of_sources",
          "citation_pattern"
        ],
        "tense": "past"
      }
    },
    {
      "rule_id": "literature_review.quality",
      "definition": "literature_review.critical_synthesis",
      "severity": "warning",
      "parameters": {
        "requires": [
          "select_key_scientific_information",
          "compare_sources",
          "critically_evaluate",
          "synthesize",
          "identify_knowledge_gaps",
          "distinguish_facts_from_speculation_or_opinion"
        ]
      }
    },
    {
      "rule_id": "content.conclusions",
      "definition": "section.conclusions",
      "severity": "warning",
      "parameters": {
        "requires": [
          "most_important_findings",
          "goal_fulfillment",
          "novel_contribution",
          "recommendations_for_practice_and_future_research"
        ],
        "tense": "past",
        "avoid_repetition": true
      }
    },
    {
      "rule_id": "references.style",
      "definition": "citations.faculty_style",
      "severity": "error",
      "parameters": {
        "allowed_styles": [
          "Ecosystems",
          "PLoS"
        ],
        "selection": "by_agreement_with_supervisor",
        "exact_punctuation_required": true
      }
    },
    {
      "rule_id": "references.completeness",
      "definition": "citations.reference_consistency",
      "severity": "error",
      "parameters": {
        "every_reference_list_entry_used_in_text": true,
        "every_in_text_citation_present_in_reference_list": true,
        "mismatch": "serious_error"
      }
    },
    {
      "rule_id": "references.ecosystems_order",
      "definition": "references.order",
      "severity": "error",
      "parameters": {
        "style": "Ecosystems",
        "order": "alphabetical_A_to_Z"
      }
    },
    {
      "rule_id": "references.plos_order",
      "definition": "references.order",
      "severity": "error",
      "parameters": {
        "style": "PLoS",
        "order": "order_of_first_appearance"
      }
    },
    {
      "rule_id": "appendices.pagination",
      "definition": "appendices.format",
      "severity": "recommendation",
      "parameters": {
        "separate_pagination": true,
        "page_number_style": "roman"
      }
    },
    {
      "rule_id": "appendices.list",
      "definition": "appendices.structure",
      "severity": "recommendation",
      "parameters": {
        "list_of_appendices_at_start": true,
        "appendices_heading_in_table_of_contents": false
      }
    },
    {
      "rule_id": "tables_figures.reference",
      "definition": "figures_tables.integration",
      "severity": "error",
      "parameters": {
        "every_in_text_table_or_figure_must_be_referenced_in_text": true
      }
    },
    {
      "rule_id": "tables_figures.numbering",
      "definition": "figures_tables.numbering",
      "severity": "error",
      "parameters": {
        "tables": "separate_sequential_series",
        "figures": "separate_sequential_series",
        "graphs": "figure_series_or_separate_graph_series"
      }
    },
    {
      "rule_id": "tables_figures.captions",
      "definition": "figures_tables.captions",
      "severity": "error",
      "parameters": {
        "table_caption": "above_table",
        "figure_caption": "below_figure",
        "naming_style": "consistent"
      }
    },
    {
      "rule_id": "tables_figures.appendix",
      "definition": "figures_tables.placement",
      "severity": "recommendation",
      "parameters": {
        "large_tables_and_supplementary_figures": "appendices"
      }
    },
    {
      "rule_id": "language.scientific",
      "definition": "writing.quality",
      "severity": "warning",
      "parameters": {
        "requires": [
          "clear_formulations",
          "scientific_language",
          "logical_paragraph_and_chapter_structure",
          "argumentation_and_critical_thinking"
        ],
        "avoid_redundancy": true
      }
    },
    {
      "rule_id": "literature_review.tables",
      "definition": "literature_review.tables",
      "severity": "recommendation",
      "parameters": {
        "large_summary_tables": "appendices",
        "compare_agreements_and_differences_between_publications": true
      }
    },
    {
      "rule_id": "submission.schedule",
      "definition": "submission.defense",
      "severity": "recommendation",
      "parameters": {
        "typical_defense_months": [
          "May",
          "June"
        ],
        "basis": "following_year_after_assignment"
      }
    },
    {
      "rule_id": "evaluation.supervisor",
      "definition": "assessment.criteria",
      "severity": "recommendation",
      "parameters": {
        "scale": [
          1,
          2,
          3,
          4
        ],
        "criteria": [
          "communication",
          "student_activity",
          "schedule_adherence",
          "methodology_choice",
          "goal_fulfillment",
          "professional_contribution",
          "theoretical_background",
          "data_and_information",
          "scientific_literature_and_citation",
          "argumentation_and_critical_thinking",
          "abstract_and_keywords",
          "text_structure",
          "clarity_and_language",
          "formulation_precision",
          "scientific_language"
        ]
      }
    },
    {
      "rule_id": "evaluation.opponent",
      "definition": "assessment.criteria",
      "severity": "recommendation",
      "parameters": {
        "scale": [
          1,
          2,
          3,
          4
        ],
        "criteria": [
          "goal_formulation",
          "methodology_choice",
          "goal_fulfillment",
          "professional_contribution",
          "originality",
          "theoretical_background",
          "data_and_information",
          "scientific_literature_and_citation",
          "argumentation_and_critical_thinking",
          "abstract_and_keywords",
          "text_structure",
          "clarity_and_language",
          "formulation_precision",
          "scientific_language",
          "formal_processing_and_overall_impression"
        ],
        "minimum_additional_questions": 2
      }
    }
  ]
}
