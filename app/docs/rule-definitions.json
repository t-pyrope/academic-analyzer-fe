{
  "schema_version": "1.0",

  "rule_definitions": [

    {
      "id": "structure.required_sections",
      "category": "structure",
      "name": "Required sections",
      "description": "Checks that required sections exist.",
      "engine": "section_presence",
      "parameters": {
        "sections": "array"
      }
    },

    {
      "id": "structure.section_order",
      "category": "structure",
